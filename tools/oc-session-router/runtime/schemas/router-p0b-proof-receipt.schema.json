{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fal.invalid/schemas/router-p0b-proof-receipt.v1.json",
  "title": "FAL sanitized P0B post-send proof receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "router_protocol_identity", "runtime_release_version", "executable_attestation_sha256", "opencode_server_version",
    "server_binary_sha256", "server_instance_identity_sha256", "target_directory_sha256", "capability_grant_sha256", "authorization_use_sha256",
    "run_authority_sha256", "operation_id_sha256", "operation_result_sha256", "transport_receipt_sha256", "snapshot_diagnostic_sha256",
    "cleanup_receipt_sha256", "session_sha256", "command_name", "command_argument_sha256", "command_body_sha256", "response_message_id_sha256",
    "response_parent_id_sha256", "response_parent_bound", "response_sha256", "terminal_sha256", "operation_status", "transport_status",
    "one_use_status", "snapshot_result", "cleanup_status", "sse_enabled", "accepted", "gate_failures", "created_at", "raw_paths_persisted",
    "raw_origin_persisted", "raw_session_id_persisted", "raw_response_persisted", "raw_reasoning_persisted", "raw_event_payload_persisted"
  ],
  "properties": {
    "schema_version": { "const": "router-p0b-proof-receipt.v1" },
    "router_protocol_identity": { "const": "fal-explicit-stage-router/v1" },
    "runtime_release_version": { "const": "0.2.0" },
    "executable_attestation_sha256": { "$ref": "#/$defs/sha256" },
    "opencode_server_version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "server_binary_sha256": { "$ref": "#/$defs/sha256" },
    "server_instance_identity_sha256": { "$ref": "#/$defs/sha256" },
    "target_directory_sha256": { "$ref": "#/$defs/sha256" },
    "capability_grant_sha256": { "$ref": "#/$defs/sha256" },
    "authorization_use_sha256": { "$ref": "#/$defs/sha256" },
    "run_authority_sha256": { "$ref": "#/$defs/sha256" },
    "operation_id_sha256": { "$ref": "#/$defs/sha256" },
    "operation_result_sha256": { "$ref": "#/$defs/sha256" },
    "transport_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "snapshot_diagnostic_sha256": { "$ref": "#/$defs/sha256" },
    "cleanup_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "session_sha256": { "$ref": "#/$defs/sha256" },
    "command_name": { "$ref": "#/$defs/opaqueId" },
    "command_argument_sha256": { "$ref": "#/$defs/sha256" },
    "command_body_sha256": { "$ref": "#/$defs/sha256" },
    "response_message_id_sha256": { "$ref": "#/$defs/sha256" },
    "response_parent_id_sha256": { "$ref": "#/$defs/sha256" },
    "response_parent_bound": { "type": "boolean" },
    "response_sha256": { "$ref": "#/$defs/sha256" },
    "terminal_sha256": { "$ref": "#/$defs/sha256" },
    "operation_status": { "enum": ["SUCCEEDED", "NOT_SUCCEEDED"] },
    "transport_status": { "enum": ["RESPONSE_ACCEPTED", "NOT_ACCEPTED"] },
    "one_use_status": { "enum": ["CONSUMED", "NOT_CONSUMED"] },
    "snapshot_result": { "enum": ["EXACT_CANDIDATE", "NOT_EXACT"] },
    "cleanup_status": { "enum": ["VERIFIED", "UNVERIFIED"] },
    "sse_enabled": { "const": false },
    "accepted": { "type": "boolean" },
    "gate_failures": { "type": "array", "uniqueItems": true, "items": { "enum": ["OPERATION_NOT_SUCCEEDED", "RESPONSE_NOT_ACCEPTED", "RESPONSE_PARENT_NOT_BOUND", "ONE_USE_NOT_CONSUMED", "SNAPSHOT_NOT_EXACT", "CLEANUP_NOT_VERIFIED"] } },
    "created_at": { "type": "string", "format": "date-time" },
    "raw_paths_persisted": { "const": false },
    "raw_origin_persisted": { "const": false },
    "raw_session_id_persisted": { "const": false },
    "raw_response_persisted": { "const": false },
    "raw_reasoning_persisted": { "const": false },
    "raw_event_payload_persisted": { "const": false }
  },
  "$defs": {
    "opaqueId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:+~-]{0,199}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
