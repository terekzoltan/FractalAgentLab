{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fractal-agent-lab.local/session-context-status.schema.json",
  "title": "OpenCode session context status",
  "type": "object",
  "required": [
    "schema_version",
    "query_scope",
    "observed_at_utc",
    "session",
    "policy",
    "model",
    "provider_observation",
    "active_context",
    "pressure",
    "capabilities",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "session-context-status/v1" },
    "query_scope": {
      "enum": ["router_target", "router_explicit", "router_all", "self"]
    },
    "observed_at_utc": { "type": "string", "format": "date-time" },
    "session": {
      "type": "object",
      "required": ["logical_name", "state", "state_source", "identity_disclosed"],
      "properties": {
        "logical_name": { "type": ["string", "null"] },
        "state": { "enum": ["idle", "busy", "retry", "unknown"] },
        "state_source": { "enum": ["status_map_explicit", "map_omission_idle", "unavailable"] },
        "identity_disclosed": { "const": false }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": ["identity", "warn_ratio", "critical_ratio"],
      "properties": {
        "identity": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@+~-]{0,159}$" },
        "warn_ratio": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "critical_ratio": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["provider_id", "model_id", "context_limit", "input_limit", "output_limit", "limit_source"],
      "properties": {
        "provider_id": { "type": ["string", "null"] },
        "model_id": { "type": ["string", "null"] },
        "context_limit": { "type": ["integer", "null"], "minimum": 1 },
        "input_limit": { "type": ["integer", "null"], "minimum": 0 },
        "output_limit": { "type": ["integer", "null"], "minimum": 0 },
        "limit_source": { "enum": ["opencode_provider_catalog", "configured_model_override", "unavailable"] }
      },
      "additionalProperties": false
    },
    "provider_observation": {
      "type": "object",
      "required": [
        "status",
        "as_of_utc",
        "provider_id",
        "model_id",
        "input_tokens",
        "output_tokens",
        "reasoning_tokens",
        "cache_read_tokens",
        "cache_write_tokens",
        "total_tokens",
        "total_source",
        "source"
      ],
      "properties": {
        "status": { "enum": ["available", "unavailable"] },
        "as_of_utc": { "type": ["string", "null"], "format": "date-time" },
        "provider_id": { "type": ["string", "null"] },
        "model_id": { "type": ["string", "null"] },
        "input_tokens": { "$ref": "#/$defs/nullableTokens" },
        "output_tokens": { "$ref": "#/$defs/nullableTokens" },
        "reasoning_tokens": { "$ref": "#/$defs/nullableTokens" },
        "cache_read_tokens": { "$ref": "#/$defs/nullableTokens" },
        "cache_write_tokens": { "$ref": "#/$defs/nullableTokens" },
        "total_tokens": { "$ref": "#/$defs/nullableTokens" },
        "total_source": {
          "enum": ["provider_reported_total", "computed_opencode_overflow_formula", "unavailable"]
        },
        "source": { "enum": ["provider_observed_last_completion", "unavailable"] }
      },
      "additionalProperties": false
    },
    "active_context": {
      "type": "object",
      "required": ["status", "messages_since_compaction", "last_compaction_utc", "estimated_tokens", "source", "confidence"],
      "properties": {
        "status": { "enum": ["available_estimate", "unavailable"] },
        "messages_since_compaction": { "type": "integer", "minimum": 0 },
        "last_compaction_utc": { "type": ["string", "null"], "format": "date-time" },
        "estimated_tokens": { "$ref": "#/$defs/nullableTokens" },
        "source": { "enum": ["derived_active_context_estimate", "unavailable"] },
        "confidence": { "enum": ["low", "none"] }
      },
      "additionalProperties": false
    },
    "pressure": {
      "type": "object",
      "required": [
        "best_available_tokens",
        "best_available_source",
        "usage_ratio",
        "usage_percent",
        "warn_ratio",
        "critical_ratio",
        "warn_tokens",
        "critical_tokens",
        "state",
        "recommendation"
      ],
      "properties": {
        "best_available_tokens": { "$ref": "#/$defs/nullableTokens" },
        "best_available_source": {
          "enum": ["provider_observed_last_completion", "derived_active_context_estimate", "unavailable"]
        },
        "usage_ratio": { "type": ["number", "null"], "minimum": 0 },
        "usage_percent": { "type": ["number", "null"], "minimum": 0 },
        "warn_ratio": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "critical_ratio": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "warn_tokens": { "$ref": "#/$defs/nullableTokens" },
        "critical_tokens": { "$ref": "#/$defs/nullableTokens" },
        "state": { "enum": ["unknown", "normal", "warn", "critical", "over_limit"] },
        "recommendation": {
          "enum": [
            "none",
            "monitor_and_prepare_boundary",
            "recommend_at_next_safe_boundary",
            "urgent_recovery_required_no_automatic_compact",
            "inspect_telemetry_do_not_guess"
          ]
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["read_only", "may_compact", "may_send", "may_mutate"],
      "properties": {
        "read_only": { "const": true },
        "may_compact": { "const": false },
        "may_send": { "const": false },
        "may_mutate": { "const": false }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "nullableTokens": {
      "type": ["integer", "null"],
      "minimum": 0
    }
  },
  "additionalProperties": false
}
